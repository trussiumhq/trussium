# Copy this file to .env before starting the template.
# The provider-free default keeps the runtime available for health checks.
TRUSSIUM_ENVIRONMENT=production

# Optional OpenAI-compatible provider configuration:
# TRUSSIUM_PROVIDER__NAME=openai
# TRUSSIUM_PROVIDER__API_KEY=replace-with-a-secret
# TRUSSIUM_PROVIDER__BASE_URL=https://api.openai.com/v1

# Optional private Ollama-compatible provider configuration:
# TRUSSIUM_PROVIDER__NAME=ollama
# TRUSSIUM_PROVIDER__BASE_URL=http://host.docker.internal:11434/v1
