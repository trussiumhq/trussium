        "options": [],
        "query": {
          "query": "label_values(trussium_http_requests_active, job)",
          "refId": "PrometheusVariableQueryEditor-Job"
        },
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {},
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "definition": "label_values(trussium_http_requests_active{job=~\"$job\"}, instance)",
        "includeAll": true,
        "label": "Instance",
        "multi": true,
        "name": "instance",
        "options": [],
        "query": {
          "query": "label_values(trussium_http_requests_active{job=~\"$job\"}, instance)",
          "refId": "PrometheusVariableQueryEditor-Instance"
        },
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Trussium Runtime Overview",
  "uid": "trussium-runtime-overview",
  "version": 1,
  "weekStart": ""
}
