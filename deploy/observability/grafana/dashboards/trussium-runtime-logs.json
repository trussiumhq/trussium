{
  "annotations": {
    "list": []
  },
  "description": "Loki investigation view for Trussium bounded structured JSON events.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "icon": "doc",
      "includeVars": false,
      "keepTime": false,
      "tags": [],
      "targetBlank": true,
      "title": "Trussium operational logging contract",
      "type": "link",
      "url": "https://github.com/trussiumhq/trussium/blob/main/docs/OPERATIONAL_LOGGING.md"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Bounded error events grouped by the parsed event name.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 12,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "options": {
        "legend": {
          "calcs": [
            "sum"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "12.2.0",
      "targets": [
        {
          "direction": "backward",
          "editorMode": "code",
          "expr": "sum by (event) (count_over_time({job=~\"$job\",instance=~\"$instance\"} | json | level=\"ERROR\" [$__interval]))",
          "legendFormat": "{{event}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Operational error events",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Provider configuration readiness transitions reported by the runtime without network probing.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 35,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "group": "A",
              "mode": "normal"
            }
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "options": {
        "legend": {
          "calcs": [
            "sum"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "pluginVersion": "12.2.0",
      "targets": [
        {
          "direction": "backward",
          "editorMode": "code",
          "expr": "sum by (event) (count_over_time({job=~\"$job\",instance=~\"$instance\"} | json | event=~\"provider\\.configuration\\.(ready|unavailable)\" [$__interval]))",
          "legendFormat": "{{event}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Provider configuration state",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Runtime configuration, startup, stopping, tracing shutdown, and terminal process events.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "pluginVersion": "12.2.0",
      "targets": [
        {
          "direction": "backward",
          "editorMode": "code",
          "expr": "{job=~\"$job\",instance=~\"$instance\"} | json | event=~\"runtime\\.(configuration\\..+|started|stopping|stopped|shutdown\\..+)|observability\\.(configuration\\.loaded|tracing\\.shutdown\\..+)\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Runtime lifecycle",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Failed or cancelled HTTP, capability, and provider execution lifecycles.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "pluginVersion": "12.2.0",
      "targets": [
        {
          "direction": "backward",
          "editorMode": "code",
          "expr": "{job=~\"$job\",instance=~\"$instance\"} | json | event=~\"(http\\.request|capability\\.execution|provider\\.execution)\\.(failed|cancelled)\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Execution failures and cancellations",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "Graceful-drain, cleanup, invalid configuration, trace export, and tracing shutdown failures.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "pluginVersion": "12.2.0",
      "targets": [
        {
          "direction": "backward",
          "editorMode": "code",
          "expr": "{job=~\"$job\",instance=~\"$instance\"} | json | event=~\"runtime\\.configuration\\.invalid|runtime\\.shutdown\\.(drain_timeout|cleanup_timeout)|observability\\.trace_export\\.failed|observability\\.tracing\\.shutdown\\.failed\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Operational failure detail",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "description": "All Trussium-owned structured events. Backend indexing, access control, and retention remain operator-owned.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "pluginVersion": "12.2.0",
      "targets": [
        {
          "direction": "backward",
          "editorMode": "code",
          "expr": "{job=~\"$job\",instance=~\"$instance\"} | json | logger=~\"trussium\\..+\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Structured event stream",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": [
    "trussium",
    "runtime",
    "loki",
    "logs"
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "label": "Loki",
        "name": "loki",
        "options": [],
        "query": "loki",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "allValue": ".+",
        "current": {},
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "definition": "label_values({job=~\".+\"}, job)",
        "includeAll": true,
        "label": "Job",
        "multi": true,
        "name": "job",
        "options": [],
        "query": "label_values({job=~\".+\"}, job)",
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".+",
        "current": {},
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "definition": "label_values({job=~\"$job\"}, instance)",
        "includeAll": true,
        "label": "Instance",
        "multi": true,
        "name": "instance",
        "options": [],
        "query": "label_values({job=~\"$job\"}, instance)",
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Trussium Runtime Logs",
  "uid": "trussium-runtime-logs",
  "version": 1,
  "weekStart": ""
}
